# Copy this file to .env and fill in your own project values.
#
# Leave both empty to run on the bundled demo data with no backend.
# .env is git-ignored: real credentials must never be committed.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AdMob ad unit ids, from the AdMob console. Leave empty to serve Google's
# test ads, which earn nothing and are safe to tap.
# The app id is separate: AndroidManifest.xml and ios/Runner/Info.plist.
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
