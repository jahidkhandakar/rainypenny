  "resetLinkSentBody": "{email} க்கு கணக்கு இருந்தால், மீட்டமைப்பு இணைப்பு வந்துகொண்டிருக்கிறது.",
  "resetLinkSentHint": "இணைப்பு ஒரு மணி நேரத்தில் காலாவதியாகும். வரவில்லை என்றால், புதியதைக் கேட்பதற்கு முன் ஸ்பேம் கோப்புறையைப் பாருங்கள்.",
  "tryAnotherEmail": "வேறு மின்னஞ்சலைப் பயன்படுத்து",
  "resetPasswordTitle": "புதிய கடவுச்சொல்லைத் தேர்ந்தெடு",
  "resetPasswordSubtitle": "இந்தக் கணக்கில் இதுவரை பயன்படுத்தாத ஒன்றைத் தேர்ந்தெடுங்கள்.",
  "passwordChangedTitle": "கடவுச்சொல் புதுப்பிக்கப்பட்டது",
  "passwordChangedBody": "உங்கள் புதிய கடவுச்சொல் சேமிக்கப்பட்டது. நீங்கள் உள்நுழைந்துள்ளீர்கள், தொடரலாம்.",
  "demoModeHint": "டெமோ பதிப்பு — கணக்கு தேவையில்லை",
  "demoModeFill": "நிரப்பு",
  "welcomeTrackTitle": "உங்கள் பணம் எங்கே செல்கிறது என்று பாருங்கள்",
  "welcomeTrackBody": "வருவதையும் போவதையும் பதிவு செய்யுங்கள். RainyPenny அதை உண்மையிலேயே படிக்கக்கூடிய ஒரு படமாக மாற்றுகிறது.",
  "welcomeBudgetTitle": "நிலைக்கும் வரம்புகள்",
  "welcomeBudgetBody": "உங்கள் செலவின் ஒவ்வொரு பகுதிக்கும் மாத உச்சவரம்பு வையுங்கள், தாண்டிய பிறகல்ல — தாண்டுவதற்கு முன்பே தெரிந்துகொள்ளுங்கள்.",
  "welcomeGoalsTitle": "முக்கியமானதற்காகச் சேமியுங்கள்",
  "welcomeGoalsBody": "இலக்குக்கு ஒரு பெயர், ஒரு தொகை வையுங்கள், அது நிறைவதைப் பாருங்கள். கண்ணுக்குத் தெரியும்போது அவசர நிதி எளிதாக உருவாகும்.",
  "welcomePrivacyTitle": "உங்கள் பணம் உங்களுடையதே",
  "welcomePrivacyBody": "உங்கள் எண்கள் உங்களுக்கு மட்டுமே. எதுவும் விற்கப்படுவதில்லை, யாருடனும் பகிரப்படுவதில்லை.",
  "stepOf": "படி {step} / {total}",
  "onboardingNameTitle": "உங்களை என்ன அழைப்பது?",
  "onboardingNameBody": "வாழ்த்துவதற்கு மட்டுமே பயன்படுத்துவோம், வேறெங்கும் இல்லை.",
  "onboardingNameHint": "முதற்பெயர் போதும். பிறகு மாற்றிக்கொள்ளலாம்.",
  "onboardingCurrencyTitle": "நீங்கள் எந்த நாணயத்தைப் பயன்படுத்துகிறீர்கள்?",
  "onboardingCurrencyBody": "செயலியில் உள்ள ஒவ்வொரு தொகையும் இந்த நாணயத்தில் காட்டப்படும். தேர்ந்தெடுப்பது எதையும் மாற்றாது.",
  "onboardingCurrencySearch": "அனைத்து நாணயங்களிலும் தேடு",
  "onboardingAppearanceTitle": "உங்களுக்கேற்ப அமையுங்கள்",
  "onboardingAppearanceBody": "ஒரு தோற்றத்தைத் தேர்ந்தெடுங்கள். தொடும்போதே எல்லாம் மாறும், எப்போது வேண்டுமானாலும் திரும்பி வரலாம்.",
  "onboardingNotificationsTitle": "கண்காணித்துக்கொண்டே இருங்கள்",
  "onboardingNotificationsBody": "சரியான தருணத்தில் வரும் அமைதியான நினைவூட்டலே இதைப் பழக்கமாக்குகிறது.",
  "onboardingNotifyReminders": "செலவழித்ததைப் பதிவு செய்ய மென்மையான நினைவூட்டல்",
  "onboardingNotifyBudget": "பட்ஜெட் தீர்வதற்கு முன் ஒரு தகவல்",
  "onboardingNotifySummary": "பணம் எங்கே சென்றது என்பதன் வாராந்திரச் சுருக்கம்",
  "onboardingNotifyEnable": "அறிவிப்புகளை இயக்கு",
  "onboardingNotifyDone": "அறிவிப்பு அமைப்புகள் சேமிக்கப்பட்டன",
  "onboardingNotifyLater": "இவை அனைத்தையும் அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றலாம்.",
  "onboardingReadyTitle": "எல்லாம் தயார்",
  "onboardingReadyTitleNamed": "எல்லாம் தயார், {name}",
  "onboardingReadyBody": "அமைப்பு முடிந்தது. எல்லாம் எப்படி வேலை செய்கிறது என்று சுருக்கமாகப் பார்க்கலாமா?",
  "onboardingTakeTour": "எனக்குக் காட்டுங்கள்",
  "onboardingGoToApp": "செயலிக்குச் செல்",
  "onboardingTourLater": "இப்போது வேண்டாமா? வழிகாட்டி அமைப்புகளில் இருக்கும், எப்போது வேண்டுமானாலும் பாருங்கள்.",
  "beginnersGuide": "தொடக்க வழிகாட்டி",
  "guideFinish": "முடி",
  "chapterOf": "அத்தியாயம் {number} / {total}",
  "guideOpenScreen": "{screen} திற",
  "guideDashboardTitle": "உங்கள் முகப்பு",
  "guideDashboardBody": "எல்லாம் இங்கிருந்தே தொடங்குகிறது. மேலே உள்ள அட்டை உங்களிடம் மீதமுள்ளதைக் காட்டுகிறது; அதற்குக் கீழே இந்தக் காலத்தின் வருமானமும் செலவும், பிறகு உங்கள் செலவு, பட்ஜெட்டுகள், இலக்குகள்.",
  "guideDashboardTip1": "எல்லாவற்றையும் ஒரே நேரத்தில் புதுப்பிக்கத் திரையைக் கீழே இழுங்கள்.",
  "guideDashboardTip2": "அந்தப் பட்டியலுக்கு நேரடியாகச் செல்ல வருமான அல்லது செலவு அட்டையைத் தட்டுங்கள்.",
  "guideDashboardTip3": "நீங்கள் ஏதேனும் பதிவு செய்தவுடன் வளையங்களும் நுண்ணறிவுகளும் புதுப்பிக்கப்படும்.",
  "guideAddTitle": "பணத்தைப் பதிவு செய்தல்",
  "guideAddBody": "பட்டியின் நடுவில் உள்ள பொத்தானே எல்லாவற்றின் தொடக்கம். அது ஒரு சிறிய பட்டியலைத் திறக்கும்: செலவு, வருமானம், கடன், பட்ஜெட் அல்லது சேமிப்பு இலக்கு.",
  "guideAddTip1": "வருமானத்தையோ செலவையோ பதிவு செய்ய நடுப் பொத்தானைத் தட்டுங்கள்.",
  "guideAddTip2": "பட்டியலைத் தவிர்த்து நேரடியாகப் புதிய செலவுக்குச் செல்ல அதை அழுத்திப் பிடியுங்கள்.",
  "guideAddTip3": "எப்போதும் ஒரு வகையைத் தேர்ந்தெடுங்கள் — வரைபடங்களும் பட்ஜெட்டுகளும் அதன் அடிப்படையிலேயே இயங்குகின்றன.",
  "guideCategoriesTitle": "வகைகள்",
  "guideCategoriesBody": "வகைகள்தான் செலவை குழுக்களாகப் பிரிக்கின்றன. செயலியுடன் வரும் வகைகள் பெரும்பாலானோருக்குப் போதும், நீங்கள் பெயரை மாற்றலாம் அல்லது உங்களுடையதைச் சேர்க்கலாம்.",
  "guideCategoriesTip1": "மாற்றவோ சேர்க்கவோ அமைப்புகள், பிறகு வகைகளை நிர்வகி.",
  "guideCategoriesTip2": "வகை இல்லாத அனைத்தும் «மற்றவை» இல் சேரும், அதனால் வரைபடங்கள் நேர்மையாக இருக்கும்.",
  "guideBudgetTitle": "பட்ஜெட்டுகள்",
  "guideBudgetBody": "பட்ஜெட் என்பது ஒரு வகைக்கான மாத உச்சவரம்பு. செலவழிக்கும்போது பட்டை நிரம்பும், வரம்பு நெருங்கும்போது நிறம் மாறும், அதனால் தாண்டுவதற்கு முன்பே தெரிந்துவிடும்.",
  "guideBudgetTip1": "எல்லாவற்றையும் ஒரே நேரத்தில் அல்ல — இரண்டு மூன்று வகைகளில் தொடங்குங்கள்.",
  "guideBudgetTip2": "வரம்பை உங்கள் வழக்கமான செலவை விடச் சற்று அதிகமாக வையுங்கள், பிறகு குறையுங்கள்.",
  "guideBudgetTip3": "பட்ஜெட் எச்சரிக்கைகளை இயக்கியே வையுங்கள், தீரும்போது செயலி எச்சரிக்கும்.",
  "guideSavingsTitle": "சேமிப்பு இலக்குகள்",
  "guideSavingsBody": "எதற்காகச் சேமிக்கிறீர்கள் என்பதற்குப் பெயரிட்டு, தொகையையும் தேதியையும் வையுங்கள் — ஒவ்வொரு மாதமும் எவ்வளவு ஒதுக்க வேண்டும் என்று செயலி கணக்கிடும்.",
  "guideSavingsTip1": "பெயரிடப்பட்ட இலக்கு, தெளிவற்ற சேமிப்பு எண்ணத்தை விட எளிதில் நிலைக்கும்.",
  "guideSavingsTip2": "ஒரு பெரிய இலக்கை விடச் சில சிறிய இலக்குகளே அடிக்கடி நிறைவேறும்.",
  "guideLoansTitle": "கடன்கள்",
  "guideLoansBody": "எவ்வளவு கடன், அதன் செலவு என்ன, அடுத்த தவணை எப்போது என்று பதிவு செய்யுங்கள். நீங்கள் கட்டி வருபவை அனைத்தும் மீதத் தொகையுடன் ஒரே பட்டியலில் இருக்கும்.",
  "guideLoansTip1": "தவணைத் தேதியைச் சேருங்கள், நினைவூட்டல்கள் உங்களுக்காகத் தொடர்ந்து நினைவூட்டும்.",
  "guideLoansTip2": "தவணை தாண்டிய கடன், கட்டப்படும் வரை முகப்பில் சிவப்பாகத் தெரியும்.",
  "guideReportsTitle": "அறிக்கைகள்",
  "guideReportsBody": "ஆழமான பார்வை: வருமானமும் செலவும், வகை வாரியான செலவு, பட்ஜெட்டுகள் எவ்வளவு நிலைத்தன, உங்கள் வருமானத்தில் எவ்வளவு மீதம்.",
  "guideReportsTip1": "திரையின் மேலே வாரம், மாதம், காலாண்டு இடையே மாறுங்கள்.",
  "guideReportsTip2": "PDF ஐ ஏற்றுமதி செய்யுங்கள் அல்லது பகிருங்கள் — அது உங்கள் மொழியிலும் திசையிலும் வரும்.",
  "guideSettingsTitle": "அமைப்புகள்",
  "guideSettingsBody": "மொழி, நாணயம், நிறங்கள், எச்சரிக்கைகள் அனைத்தும் இங்கே. தொடக்க அமைப்பால் எதுவும் நிரந்தரமாகிவிடாது — எப்போது வேண்டுமானாலும் மாற்றுங்கள்.",
  "guideSettingsTip1": "நாற்பது மொழிகள், மேலும் வலமிருந்து இடமாகப் படிக்கும் மொழிகளுக்கு முழு அமைப்பும் பிரதிபலிக்கும்.",
  "guideSettingsTip2": "எந்த எச்சரிக்கைகள் வேண்டும், அவை எந்த நேரங்களில் வரலாம் என்று தேர்ந்தெடுங்கள்.",
  "guideSettingsTip3": "அமைதி நேரம் அனைத்தையும் காலை வரை நிறுத்தி வைக்கும்.",
  "guideHabitTitle": "பழக்கமாக்குங்கள்",
  "guideHabitBody": "நீங்கள் எவ்வளவு போடுகிறீர்களோ அவ்வளவே செயலி பயனுள்ளது. மாதம் ஒரு மணி நேரத்தை விட நாளொன்றுக்கு ஒரு நிமிடம் மேல், இரண்டு வாரங்களில் எண்கள் ஏதோ சொல்லத் தொடங்கும்.",
  "guideHabitTip1": "வாரக்கடைசியில் அல்ல, செலவழிக்கும் அந்த நேரத்திலேயே பதிவு செய்யுங்கள்.",
  "guideHabitTip2": "நாளொன்றுக்கு ஒரு முறை முகப்பைப் பாருங்கள். பத்து வினாடிகள் போதும்.",
